# Базовый URL OpenAI-совместимого провайдера (без хвостового слеша).
# По умолчанию — apiyi.com. Чтобы вернуться на OpenRouter:
# BASE_URL=https://openrouter.ai/api/v1
BASE_URL=https://api.apiyi.com/v1

# Ключ от провайдера (для apiyi.com / OpenRouter / любой OpenAI-совместимой API).
OPENROUTER_API_KEY=

# Модель по умолчанию. Бесплатные варианты:
#   google/gemini-2.0-flash-exp:free
#   google/gemini-flash-1.5-8b
#   meta-llama/llama-3.1-8b-instruct:free
MODEL=google/gemini-2.0-flash-exp:free

# Порт сервера
PORT=3000

# (Опционально) для рейтинга OpenRouter
APP_URL=http://localhost:3000
APP_TITLE=Lin-Lingua

# Авторизация (логин/пароль на вход в приложение)
AUTH_USER=pankov
AUTH_PASS=Salkon
# Секрет для подписи сессий. Задайте свой длинный случайный,
# иначе сессии сбрасываются при каждом рестарте сервера.
AUTH_SECRET=
